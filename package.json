{
  "name": "certifyx-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src scripts --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:parity": "playwright test tests/e2e/parity.spec.ts --project=chromium",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.1.1",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/playfair-display": "^5.1.1",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
